# ---------- LINE Messaging API (บอท) ----------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- LINE Login (สำหรับ LIFF) ----------
# Channel ID ของ LINE Login channel ที่สร้าง LIFF app ไว้
LINE_LOGIN_CHANNEL_ID=
# LIFF ID เช่น 2001234567-AbCdEfGh
LIFF_ID=

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ service_role key (เก็บเป็นความลับ ห้ามใส่ในเว็บ)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=bill-files

# ---------- บริการตรวจสลิป ----------
# easyslip หรือ slipok
SLIP_PROVIDER=easyslip
EASYSLIP_API_KEY=
# EASYSLIP_URL=https://api.easyslip.com/v2/verify/bank
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# ยอมให้โอนเกินได้ไม่เกินกี่บาท (เช่น ปัด 162.50 เป็น 163)
AMOUNT_OVERPAY_TOLERANCE=1

# ---------- การทวง ----------
# รหัสลับสำหรับเรียก /cron/remind จากตัวตั้งเวลาภายนอก
CRON_SECRET=
# true = เซิร์ฟเวอร์ทวงเองตามเวลาด้านล่าง (ใช้ได้เมื่อเซิร์ฟเวอร์เปิดตลอด)
ENABLE_INTERNAL_CRON=false
REMIND_TIME=18:00
TIMEZONE=Asia/Bangkok
# true = บอทโพสต์สรุปในกลุ่มทุกครั้งที่สร้างบิลใหม่ (ใช้โควตาข้อความ)
ANNOUNCE_NEW_BILL=true
# true = เมื่อแนบสลิปผ่านเว็บแล้วตรวจผ่าน บอทจะแจ้งในกลุ่มด้วย (ใช้โควตาข้อความ)
ANNOUNCE_WEB_SLIP=true

# ---------- ผู้ดูแล ----------
# LINE userId ของผู้ดูแล คั่นด้วยจุลภาค (ดูได้จากหน้าเลือกกลุ่มของเว็บ) ผู้ดูแลจะเห็นทุกกลุ่มที่บอทอยู่
ADMIN_LINE_USER_IDS=

# ---------- ทั่วไป ----------
PORT=3000
# โฟลเดอร์ไฟล์เว็บที่ build แล้ว
WEB_DIST=../web/dist
# สำหรับทดสอบในเครื่องเท่านั้น: ข้ามการตรวจ LIFF token และใช้ LINE userId นี้แทน
# DEV_AUTH_USER_ID=Uxxxxxxxx
